rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when this session is a companion device (custom claim set by the
    // mintCompanionToken Cloud Function).
    //
    // IMPORTANT: primary sessions have NO `companion` claim at all. Reading a
    // missing key on request.auth.token throws an evaluation error. token.get()
    // with a default avoids that.
    function isCompanion() {
      return isSignedIn() && request.auth.token.get('companion', false) == true;
    }

    // True when the caller is an active agent of the owner who appears in
    // the supplied members list.
    //
    // Parameterised (Issue — new regression fix): the original isAgentOfChatOwner()
    // read resource.data.members, which works at the /chats/{chatId} level but
    // fails inside subcollections (/messages, /assignmentHistory) because
    // resource there is the sub-document, not the parent chat.
    //
    // Usage:
    //   At chat level  : isAgentOfOwnerIn(resource.data.members)
    //   At sub-doc level: isAgentOfOwnerIn(
    //                       get(/databases/$(database)/documents/chats/$(chatId)).data.members)
    function isAgentOfOwnerIn(members) {
      let callerDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let bOwner = callerDoc.data.businessOwnerUid;
      return isSignedIn()
        && !isCompanion()
        && bOwner != null
        && exists(/databases/$(database)/documents/businessTeams/$(bOwner)/agents/$(request.auth.uid))
        && bOwner in members;
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId) && !isCompanion();

      // Profile-view counters are now written exclusively through the
      // recordProfileView Cloud Function (Admin SDK), so the counter-increment
      // branch has been removed. Only the owner (primary, non-companion) may
      // update their own doc. businessOwnerUid and agentRole are excluded to
      // prevent self-grant of agent privileges.
      allow update: if isOwner(userId)
        && !isCompanion()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['businessOwnerUid', 'agentRole']);

      // Blocked contacts — read by owner or the blocked user; write primary only.
      match /blockedUsers/{blockedId} {
        allow read:  if isOwner(userId) || (isSignedIn() && request.auth.uid == blockedId);
        allow write: if isOwner(userId) && !isCompanion();
      }

      // Call history — owner-only read; any signed-in user may write (so the
      // other participant can record their own history entry).
      match /callHistory/{callId} {
        allow read:  if isOwner(userId);
        allow write: if isSignedIn();
      }

      // Linked devices — primary only.
      match /linkedDevices/{deviceId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) && !isCompanion();
      }

      // Push tokens — owner only (primary and companion share the owner uid).
      match /pushTokens/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Analytics stats.
      match /stats/{statDoc} {
        allow read, write: if isOwner(userId);
      }

      // Synced contacts.
      match /syncedContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat labels.
      match /chatLabels/{labelId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Chats ───────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        isAgentOfOwnerIn(resource.data.members)
      );

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        isAgentOfOwnerIn(resource.data.members)
      );

      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && !isCompanion();

      match /messages/{messageId} {
        // Sub-doc fix: pass the parent chat's members explicitly so
        // isAgentOfOwnerIn() can compare bOwner against the chat members
        // rather than the message document (which has no members field).
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfOwnerIn(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
        );

        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.auth.uid == request.resource.data.senderId;

        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfOwnerIn(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
        );

        allow delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && !isCompanion();
      }

      match /assignmentHistory/{entryId} {
        // Same sub-doc fix as messages.
        allow read, create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfOwnerIn(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
        );
        allow update, delete: if false;
      }
    }

    // ── Businesses ──────────────────────────────────────────────────────────
    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.agents
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.ownerId &&
        !isCompanion();
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        !isCompanion();
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        !isCompanion();
    }

    // ── Business Teams ──────────────────────────────────────────────────────
    // businessOwnerUid and agentRole on user docs are written only by the
    // server-side addAgent/removeAgent path. The users update rule above
    // blocks users from setting those fields on their own doc.
    match /businessTeams/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow write: if isOwner(ownerUid) && !isCompanion();

      match /agents/{agentUid} {
        allow read: if isOwner(ownerUid) || (isSignedIn() && request.auth.uid == agentUid);

        allow create, delete: if isOwner(ownerUid) && !isCompanion();

        allow update: if (isOwner(ownerUid) && !isCompanion()) || (
          isSignedIn() &&
          request.auth.uid == agentUid &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys())
        );
      }
    }

    // ── Statuses ────────────────────────────────────────────────────────────
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && !isCompanion();
    }

    // ── Meetings ────────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      function isMeetingParticipant() {
        return isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/meetings/$(meetingId)).data.participants;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.organizerId &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.organizerId ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.organizerId;

      match /messages/{messageId} {
        allow read: if isMeetingParticipant();
        allow create: if isMeetingParticipant() && request.auth.uid == request.resource.data.senderId;
        allow update: if isMeetingParticipant();
        allow delete: if isMeetingParticipant();
      }

      match /recordings/{recordingId} {
        allow read: if isMeetingParticipant();
        allow create: if isMeetingParticipant();
        allow update: if isMeetingParticipant();
        allow delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/meetings/$(meetingId)).data.organizerId;
      }
    }

    // ── Device Link Tokens ──────────────────────────────────────────────────
    // Companion custom token IS stored in this document after claim so the
    // companion device can poll and retrieve it. The rules below prevent anyone
    // other than the requester/owner from reading a claimed (token-bearing) doc.
    match /deviceLinkTokens/{requestId} {
      // Before claim: the doc has no sensitive data; any signed-in user may
      // read so the primary can get() it inside the claim transaction.
      // After claim: the doc contains companionCustomToken — restrict to
      // the requester (companion) and the owner who claimed it.
      allow get: if isSignedIn() && (
        resource.data.consumed == false ||
        request.auth.uid == resource.data.requesterUid ||
        request.auth.uid == resource.data.ownerUid
      );

      // List: used by findRequestByDisplayCode on the primary device.
      // Restricted to consumed == false so a claimed doc (containing the token)
      // can never be returned by a list query — closing the enumeration attack.
      allow list: if isSignedIn()
                  && request.query.limit == 1
                  && resource.data.consumed == false;

      allow create: if isSignedIn()
                    && request.resource.data.requestId    == requestId
                    && request.resource.data.requestId    is string
                    && request.resource.data.requestId.size() == 64
                    && request.resource.data.displayCode  is string
                    && request.resource.data.displayCode.size() == 10
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.deviceId     is string
                    && request.resource.data.deviceId.size() > 0
                    && request.resource.data.deviceName   is string
                    && request.resource.data.deviceName.size() > 0
                    && request.resource.data.consumed     == false
                    && request.resource.data.ownerUid     == null
                    && request.resource.data.consumedAt   == null
                    && request.resource.data.expiresAt    is timestamp
                    && request.resource.data.expiresAt    >  request.time
                    && request.resource.data.expiresAt    <  request.time + duration.value(15, 'm');

      // Primary claims: sets consumed, ownerUid, consumedAt, consumedByName,
      // and companionCustomToken. Only the core identity fields are pinned.
      allow update: if isSignedIn()
                    && resource.data.consumed == false
                    && resource.data.ownerUid == null
                    && request.time < resource.data.expiresAt
                    && request.resource.data.consumed     == true
                    && request.resource.data.ownerUid     == request.auth.uid
                    && request.resource.data.requestId    == resource.data.requestId
                    && request.resource.data.displayCode  == resource.data.displayCode
                    && request.resource.data.requesterUid == resource.data.requesterUid
                    && request.resource.data.deviceId     == resource.data.deviceId
                    && request.resource.data.expiresAt    == resource.data.expiresAt;

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.requesterUid ||
        request.auth.uid == resource.data.ownerUid
      );
    }

    // ── Calls ───────────────────────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.caller.userId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );

      match /candidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── Broadcast lists ─────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.createdBy;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy;
    }

  }
}
