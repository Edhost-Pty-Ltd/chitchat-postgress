rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when this session is a companion device (custom claim set by the
    // mintCompanionToken Cloud Function).
    //
    // IMPORTANT: primary sessions have NO `companion` claim at all. Reading a
    // missing key on request.auth.token throws an evaluation error, which makes
    // the whole rule (including `!isCompanion()`) deny. token.get(key, default)
    // returns the default instead of erroring.
    function isCompanion() {
      return isSignedIn() && request.auth.token.get('companion', false) == true;
    }

  // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId) && !isCompanion();

      // ALLOW UPDATE IF:
      // 1. It is the user updating their own profile (and they are not on a companion device)
      // OR
      // 2. It is a Business Owner linking this user as an agent. The owner is ONLY
      //    allowed to touch 'businessOwnerUid' and 'agentRole', and they must be setting
      //    'businessOwnerUid' to their own UID.
      // OR
      // 3. It is a signed-in user incrementing ONLY the profile-view counters
      //    (used by trackProfileView). The increment must be exactly +1 on the
      //    two integer counters, and the caller must not be the doc's owner
      //    (owners use rule 1) or a companion device.
      allow update: if (isOwner(userId) && !isCompanion()) || 
        (
          isSignedIn() && 
          !isCompanion() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessOwnerUid', 'agentRole']) &&
          request.resource.data.businessOwnerUid == request.auth.uid
        ) ||
        (
          // Counter-only update from any signed-in non-companion viewer.
          // This is what feeds the live dashboard analytics.
          isSignedIn() &&
          !isCompanion() &&
          request.auth.uid != userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'profileViews',
            'profileViewsToday',
            'profileViewsDayKey',
            'profileViewsUpdatedAt'
          ]) &&
          request.resource.data.profileViews is int &&
          request.resource.data.profileViews == resource.data.profileViews + 1 &&
          request.resource.data.profileViewsToday is int &&
          (
            // Normal increment (same day)
            request.resource.data.profileViewsToday == resource.data.profileViewsToday + 1 ||
            // Day rollover — reset to 1
            request.resource.data.profileViewsToday == 1
          )
        );

      // Blocked contacts — read by owner or the blocked user; write primary only.
      match /blockedUsers/{blockedId} {
        allow read:  if isOwner(userId) || (isSignedIn() && request.auth.uid == blockedId);
        allow write: if isOwner(userId) && !isCompanion();
      }

      // Call history — any signed-in user can write their own entry.
      match /callHistory/{callId} {
        allow read, write: if isSignedIn();
      }

      // Linked devices — primary only (claim transaction, remove).
      match /linkedDevices/{deviceId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) && !isCompanion();
      }

      // Push tokens — one per device. Both primary and companion write their
      // own entry under users/{ownerUid}/pushTokens/{deviceId}.
      match /pushTokens/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Message / analytics stats — written by the app after aggregating.
      // Only the owner (and their companion devices, which share the same auth
      // uid) can read or write these counters.
      match /stats/{statDoc} {
        allow read, write: if isOwner(userId);
      }
      
      // Synced contacts
      match /syncedContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat labels — user-defined tabs grouping chats (direct + group).
      // Each account can only read/write its own labels. Companions sign in
      // as the owner, so isOwner(userId) is true for them too.
      match /chatLabels/{labelId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Chats ───────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      function isAgentOfChatOwner() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessOwnerUid != null
          && exists(/databases/$(database)/documents/businessTeams/$(
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessOwnerUid
             )/agents/$(request.auth.uid));
      }

      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        isAgentOfChatOwner()
      );

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        isAgentOfChatOwner()
      );

      // Delete chat — primary only.
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && !isCompanion();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfChatOwner()
        );

        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.auth.uid == request.resource.data.senderId;

        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfChatOwner()
        );

        // Delete message — primary only.
        allow delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && !isCompanion();
      }

      match /assignmentHistory/{entryId} {
        allow read, create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfChatOwner()
        );
        allow update, delete: if false;
      }
    }

    // ── Businesses ──────────────────────────────────────────────────────────
    // businesses/{businessId} — created/owned by the business owner.
    // Agents (listed in business.agents array) can read but not write.
    match /businesses/{businessId} {
      // Owner can do everything; agents can read; no-one else.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.agents
      );

      // Only the owner can create a business document.
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.ownerId &&
        !isCompanion();

      // Owner (non-companion) can update settings, name, plan, agents list.
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        !isCompanion();

      // Only the owner can delete.
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        !isCompanion();
    }

    // ── Business Teams ──────────────────────────────────────────────────────
    match /businessTeams/{ownerUid} {
      allow read: if isOwner(ownerUid);
      // Companion cannot modify the team.
      allow write: if isOwner(ownerUid) && !isCompanion();

      match /agents/{agentUid} {
        allow read: if isOwner(ownerUid) || (isSignedIn() && request.auth.uid == agentUid);

        allow create, delete: if isOwner(ownerUid) && !isCompanion();

        allow update: if (isOwner(ownerUid) && !isCompanion()) || (
          isSignedIn() &&
          request.auth.uid == agentUid &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys())
        );
      }
    }

    // ── Statuses ────────────────────────────────────────────────────────────
    match /statuses/{statusId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;

      allow update: if isSignedIn();

      // Delete status — primary only.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && !isCompanion();
    }

    // ── Meetings ────────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      function isMeetingParticipant() {
        return isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/meetings/$(meetingId)).data.participants;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.organizerId &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.organizerId ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.organizerId;

      match /messages/{messageId} {
        allow read: if isMeetingParticipant();
        allow create: if isMeetingParticipant() &&
          request.auth.uid == request.resource.data.senderId;
        allow update: if isMeetingParticipant();
        allow delete: if isMeetingParticipant();
      }

      match /recordings/{recordingId} {
        allow read: if isMeetingParticipant();
        allow create: if isMeetingParticipant();
        allow update: if isMeetingParticipant();
        allow delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/meetings/$(meetingId)).data.organizerId;
      }
    }

    // ── Device Link Tokens ──────────────────────────────────────────────────
    // The primary writes:
    //   { consumed, ownerUid, consumedAt, consumedByName, companionCustomToken }
    // The companion reads, then signs in with the token (which immediately
    // becomes an auth.uid == ownerUid session).
    match /deviceLinkTokens/{requestId} {
      allow get:  if true;
      allow list: if isSignedIn() && request.query.limit == 1;

      allow create: if isSignedIn()
                    && request.resource.data.requestId    == requestId
                    && request.resource.data.requestId    is string
                    && request.resource.data.requestId.size() == 64
                    && request.resource.data.displayCode  is string
                    && request.resource.data.displayCode.size() == 10
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.deviceId     is string
                    && request.resource.data.deviceId.size() > 0
                    && request.resource.data.deviceName   is string
                    && request.resource.data.deviceName.size() > 0
                    && request.resource.data.consumed     == false
                    && request.resource.data.ownerUid     == null
                    && request.resource.data.consumedAt   == null
                    && request.resource.data.expiresAt    is timestamp
                    && request.resource.data.expiresAt    >  request.time
                    && request.resource.data.expiresAt    <  request.time + duration.value(15, 'm');

      // Primary claims: sets consumed + ownerUid + companionCustomToken.
      allow update: if isSignedIn()
                    && resource.data.consumed == false
                    && resource.data.ownerUid == null
                    && request.time < resource.data.expiresAt
                    && request.resource.data.consumed   == true
                    && request.resource.data.ownerUid   == request.auth.uid
                    && request.resource.data.companionCustomToken is string
                    && request.resource.data.requestId     == resource.data.requestId
                    && request.resource.data.displayCode   == resource.data.displayCode
                    && request.resource.data.requesterUid  == resource.data.requesterUid
                    && request.resource.data.deviceId      == resource.data.deviceId
                    && request.resource.data.deviceName    == resource.data.deviceName
                    && request.resource.data.deviceType    == resource.data.deviceType
                    && request.resource.data.os            == resource.data.os
                    && request.resource.data.platform      == resource.data.platform
                    && request.resource.data.expiresAt     == resource.data.expiresAt
                    && request.resource.data.createdAt     == resource.data.createdAt;

      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.requesterUid
                        || request.auth.uid == resource.data.ownerUid);
    }

    // ── Calls ───────────────────────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.caller.userId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );

      match /candidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }
  // Broadcast lists — only the creator can read/write their own lists
    match /broadcasts/{broadcastId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.createdBy;

      // Allow create (resource.data doesn't exist yet on create)
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy;
    }
 
  }
}