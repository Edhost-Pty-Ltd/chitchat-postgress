rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when this session is a companion device (custom claim set by the
    // mintCompanionToken Cloud Function).
    //
    // IMPORTANT: primary sessions have NO `companion` claim at all. Reading a
    // missing key on request.auth.token throws an evaluation error, which makes
    // the whole rule (including `!isCompanion()`) deny. token.get(key, default)
    // returns the default instead of erroring.
    function isCompanion() {
      return isSignedIn() && request.auth.token.get('companion', false) == true;
    }

    // True when the caller is an active agent of the business owner that owns
    // the chat identified by `members`, i.e.:
    //   caller.users/{uid}.businessOwnerUid == someOwner
    //   && businessTeams/{someOwner}/agents/{uid} exists
    //   && someOwner in members                 ← ties access to that chat
    //
    // The chat's member list is passed in explicitly so this works both for
    // the chat document itself (resource.data.members) and for its
    // subcollections (messages / assignmentHistory), where `resource` is the
    // sub-document and has no `members` field. Callers in subcollections must
    // pass the PARENT chat's members:
    //   isAgentOfOwnerIn(get(/.../chats/$(chatId)).data.members)
    //
    // FIX (Issue 2): previously a single no-arg helper read
    // `resource.data.members`, which is absent on message/history docs and so
    // denied all agent message access. Passing the members list in fixes that
    // while keeping the cross-tenant scoping from Issue 1.
    function isAgentOfOwnerIn(members) {
      let callerDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let bOwner = callerDoc.data.businessOwnerUid;
      return isSignedIn()
        && !isCompanion()
        && bOwner != null
        && exists(/databases/$(database)/documents/businessTeams/$(bOwner)/agents/$(request.auth.uid))
        && bOwner in members;
    }

  // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId) && !isCompanion();

      // ALLOW UPDATE IF the user is updating their own profile (non-companion
      // primary only).
      //   Excluded fields: businessOwnerUid and agentRole — those are only
      //   ever written by the owner linking/unlinking agents via addAgent/
      //   removeAgent (server-side Cloud Function or admin SDK), never by the
      //   user themselves. Allowing self-write of businessOwnerUid would let
      //   any user self-grant agent privileges (Issue 8 — FIXED).
      //
      // FIX (Issue 3): the profile-view counter fields (profileViews,
      // profileViewsToday, profileViewsDayKey, profileViewsUpdatedAt) are NO
      // LONGER client-writable. They are incremented exclusively by the
      // recordProfileView callable via the Admin SDK, which bypasses these
      // rules. The previous client-write branch let any signed-in user inflate
      // another user's counters with repeated +1 writes, so it has been
      // removed. A non-companion owner updating their own doc must therefore
      // not change these counter fields directly.
      allow update: if
          isOwner(userId) &&
          !isCompanion() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'businessOwnerUid',
              'agentRole',
              'profileViews',
              'profileViewsToday',
              'profileViewsDayKey',
              'profileViewsUpdatedAt'
            ]);

      // Blocked contacts — read by owner or the blocked user; write primary only.
      match /blockedUsers/{blockedId} {
        allow read:  if isOwner(userId) || (isSignedIn() && request.auth.uid == blockedId);
        allow write: if isOwner(userId) && !isCompanion();
      }

      // Call history — owner-only read; write restricted to call participants.
      // FIX (Issue 9): previously widened to any signed-in user. Restored to
      // owner-only read. Write is still allowed for any signed-in user so the
      // other participant in the call can write their own history entry.
      match /callHistory/{callId} {
        allow read:  if isOwner(userId);
        allow write: if isSignedIn();
      }

      // Linked devices — primary only (claim transaction, remove).
      match /linkedDevices/{deviceId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) && !isCompanion();
      }

      // Push tokens — one per device. Both primary and companion write their
      // own entry under users/{ownerUid}/pushTokens/{deviceId}.
      match /pushTokens/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Message / analytics stats — written by the app after aggregating.
      match /stats/{statDoc} {
        allow read, write: if isOwner(userId);
      }

      // Synced contacts
      match /syncedContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat labels
      match /chatLabels/{labelId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Chats ───────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        isAgentOfOwnerIn(resource.data.members)
      );

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        isAgentOfOwnerIn(resource.data.members)
      );

      // Delete chat — primary member only.
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && !isCompanion();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfOwnerIn(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
        );

        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.auth.uid == request.resource.data.senderId;

        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfOwnerIn(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
        );

        allow delete: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && !isCompanion();
      }

      match /assignmentHistory/{entryId} {
        allow read, create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAgentOfOwnerIn(get(/databases/$(database)/documents/chats/$(chatId)).data.members)
        );
        allow update, delete: if false;
      }
    }

    // ── Businesses ──────────────────────────────────────────────────────────
    match /businesses/{businessId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.agents
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.ownerId &&
        !isCompanion();
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        !isCompanion();
      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        !isCompanion();
    }

    // ── Business Teams ──────────────────────────────────────────────────────
    // FIX (Issue 8): businessOwnerUid and agentRole on user docs are now ONLY
    // writable via the server-side addAgent/removeAgent path (admin SDK /
    // Cloud Functions). The users update rule no longer allows users to set
    // these fields on their own doc. A malicious user can no longer self-grant
    // agent access by writing businessOwnerUid = self and then creating an
    // agents/{self} doc here.
    match /businessTeams/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow write: if isOwner(ownerUid) && !isCompanion();

      match /agents/{agentUid} {
        allow read: if isOwner(ownerUid) || (isSignedIn() && request.auth.uid == agentUid);

        allow create, delete: if isOwner(ownerUid) && !isCompanion();

        allow update: if (isOwner(ownerUid) && !isCompanion()) || (
          isSignedIn() &&
          request.auth.uid == agentUid &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys())
        );
      }
    }

    // ── Statuses ────────────────────────────────────────────────────────────
    match /statuses/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId
        && !isCompanion();
    }

    // ── Meetings ────────────────────────────────────────────────────────────
    match /meetings/{meetingId} {
      function isMeetingParticipant() {
        return isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/meetings/$(meetingId)).data.participants;
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.organizerId &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.organizerId ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.organizerId;

      match /messages/{messageId} {
        allow read: if isMeetingParticipant();
        allow create: if isMeetingParticipant() && request.auth.uid == request.resource.data.senderId;
        allow update: if isMeetingParticipant();
        allow delete: if isMeetingParticipant();
      }

      match /recordings/{recordingId} {
        allow read: if isMeetingParticipant();
        allow create: if isMeetingParticipant();
        allow update: if isMeetingParticipant();
        allow delete: if isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/meetings/$(meetingId)).data.organizerId;
      }
    }

    // ── Device Link Tokens ──────────────────────────────────────────────────
    // Removed the old `allow get: if true` which was world-readable.
    //
    // NOTE: the companion custom token IS written into this document during the
    // claim transaction (claimLinkRequest sets `companionCustomToken` so the
    // companion can pick it up via its onSnapshot listener). Because the token
    // is a full owner-level credential, access to any doc that could hold it is
    // locked down at the rule level:
    //   - get:  a consumed doc (consumed == true, where the token lives) is
    //           only readable by the requester (companion) or the claiming
    //           owner. Unconsumed docs carry no token and are readable by any
    //           signed-in user (needed before the requester identity exists).
    //   - list: restricted to consumed == false (Issue 1 fix), so no list query
    //           can ever return a token-bearing doc.
    // A stronger follow-up would be to stop persisting the token in Firestore
    // entirely and deliver it to the companion out of band; until then these
    // rules keep the token unreadable to any party other than the requester
    // and owner.
    //
    // These rules allow:
    //   - Any signed-in user to read an UNCONSUMED request (no token present).
    //   - The requester (companion) and claiming owner to read a consumed doc.
    //   - The authenticated owner to claim (update) it.
    //   - The requester to create their own doc.
    //   - Owner or requester to delete.
    match /deviceLinkTokens/{requestId} {
      // Read rules:
      //   Before claim (consumed == false): any signed-in user may read.
      //     The doc contains no sensitive data yet — companionCustomToken is
      //     only written during the claim update.
      //   After claim (consumed == true): restricted to the requester (companion)
      //     and the owner who claimed it. This is when companionCustomToken is
      //     present, so we protect it from other signed-in users.
      allow get: if isSignedIn() && (
        resource.data.consumed == false ||
        request.auth.uid == resource.data.requesterUid ||
        request.auth.uid == resource.data.ownerUid
      );

      // List: only for findRequestByDisplayCode on the primary (owner) device,
      // which queries .where('displayCode','==',code).where('consumed','==',false).limit(1).
      //
      // FIX (Issue 1): the rule now REQUIRES resource.data.consumed == false,
      // so a claimed token doc (consumed == true, which is where
      // companionCustomToken lives) can never be returned by any list query.
      // This closes the takeover vector where a signed-in user ran
      // .where('consumed','==',true).limit(1) to read a claimed token: that
      // query would return consumed == true docs and is now denied. The
      // legitimate lookup already filters consumed == false, so it is
      // unaffected.
      allow list: if isSignedIn()
                   && request.query.limit == 1
                   && resource.data.consumed == false;

      allow create: if isSignedIn()
                    && request.resource.data.requestId    == requestId
                    && request.resource.data.requestId    is string
                    && request.resource.data.requestId.size() == 64
                    && request.resource.data.displayCode  is string
                    && request.resource.data.displayCode.size() == 10
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.deviceId     is string
                    && request.resource.data.deviceId.size() > 0
                    && request.resource.data.deviceName   is string
                    && request.resource.data.deviceName.size() > 0
                    && request.resource.data.consumed     == false
                    && request.resource.data.ownerUid     == null
                    && request.resource.data.consumedAt   == null
                    && request.resource.data.expiresAt    is timestamp
                    && request.resource.data.expiresAt    >  request.time
                    && request.resource.data.expiresAt    <  request.time + duration.value(15, 'm');

      // Primary claims: sets consumed + ownerUid + consumedAt + consumedByName
      // + companionCustomToken. The token doc is no longer world-readable
      // (get requires requester or owner auth) so storing the token here is safe.
      //
      // Only the core identity fields are pinned to their original values.
      // deviceName / deviceType / os / platform are NOT pinned — they may be
      // absent on docs created by older app versions and would cause spurious
      // permission-denied errors.
      allow update: if isSignedIn()
                    && resource.data.consumed == false
                    && resource.data.ownerUid == null
                    && request.time < resource.data.expiresAt
                    && request.resource.data.consumed      == true
                    && request.resource.data.ownerUid      == request.auth.uid
                    && request.resource.data.requestId     == resource.data.requestId
                    && request.resource.data.displayCode   == resource.data.displayCode
                    && request.resource.data.requesterUid  == resource.data.requesterUid
                    && request.resource.data.deviceId      == resource.data.deviceId
                    && request.resource.data.expiresAt     == resource.data.expiresAt;

      allow delete: if isSignedIn()
                    && (request.auth.uid == resource.data.requesterUid
                        || request.auth.uid == resource.data.ownerUid);
    }

    // ── Calls ───────────────────────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.caller.userId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.caller.userId ||
        request.auth.uid == resource.data.callee.userId
      );

      match /candidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── Broadcast lists ─────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == resource.data.createdBy;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy;
    }

  }
}
