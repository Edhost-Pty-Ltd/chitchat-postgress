{
  "expo": {
    "name": "ChitChat Business",
    "slug": "Chit-Chat",
    "version": "1.3.1",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "icon": "./assets/chitchat-logo.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "precompiledFrameworks": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edhost.ChitChatBusiness",
      "appleTeamId": "3D9KRP86P4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ChitChat Business needs access to your photo library to share images and videos in chats.",
        "NSPhotoLibraryAddUsageDescription": "ChitChat Business needs permission to save photos to your library.",
        "NSCameraUsageDescription": "ChitChat Business needs camera access to take photos and videos.",
        "NSMicrophoneUsageDescription": "ChitChat Business needs access to your microphone to record voice notes.",
        "NSContactsUsageDescription": "ChitChat Business needs access to your contacts to help you find friends on the app.",
        "NSUserNotificationsUsageDescription": "ChitChat Business needs permission to send you notifications for new messages, calls, and status updates.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "autolinking": {
      "ios": {
        "buildFromSource": [
          ".*"
        ]
      },
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "ChitChat uses your contacts to help you invite friends to meetings."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "deploymentTarget": "16.4",
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth"
            ]
          },
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "@react-native-firebase/app",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "ChitChat Business needs access to your microphone to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photoPermission": "ChitChat Business needs access to your photos to share images in chats.",
          "cameraPermission": "ChitChat Business needs camera access to take photos and videos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ChitChat Business needs camera access to take photos and videos.",
          "microphonePermission": "ChitChat Business needs microphone access to record videos with sound."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ChitChat Business needs access to your photos to share images in chats.",
          "savePhotosPermission": "ChitChat Business needs permission to save photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#0A2463",
          "mode": "production"
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-community/datetimepicker",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "ChitChat Business needs access to your camera for video calls.",
          "microphonePermission": "ChitChat Business needs access to your microphone for video calls."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "./plugins/withFaceAISDK.js"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/chitchat-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.edhost.ChitChatBusiness",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5a60de81-ed09-49dd-9ab9-3e6d63f9436d"
      }
    },
    "owner": "alex_sly"
  }
}