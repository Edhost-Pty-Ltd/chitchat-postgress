# ─── ChitChatBusiness backend environment ───────────────────────────────────
# Copy to .env and fill in real values. Every variable here is required unless
# marked optional; the server exits on startup if a required one is missing.

# HTTP listen port for the REST API + Socket.IO gateway.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string.
# Matches docker-compose.yml defaults.
DATABASE_URL=postgres://chitchat:chitchat@localhost:5432/chitchat

# Redis connection string (presence, typing, pub/sub adapter, rate limits, BullMQ).
REDIS_URL=redis://localhost:6379

# ─── Object store (S3-compatible: MinIO locally, S3 / R2 in prod) ────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chitchat-media
S3_ACCESS_KEY_ID=chitchat
S3_SECRET_ACCESS_KEY=chitchat-secret
# true for MinIO / path-style endpoints; false for AWS S3 virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# ─── Firebase Admin (token verification only — Auth stays on Firebase) ───────
# Provide EITHER a path to a service-account JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...OR the raw JSON (useful for container deploys). One of the two is required.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# The Firebase project id (defaults to the service account's project_id).
FIREBASE_PROJECT_ID=chitchatbusiness-880ce

# ─── CORS / Socket.IO origins ────────────────────────────────────────────────
# Comma-separated allow-list of origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Expo push endpoint (override only for testing).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ─── AI meeting minutes (optional) ───────────────────────────────────────────
# Server-side Gemini key used to transcribe meeting recordings and write the
# minutes (replaces the summarizeMeetingRecording Cloud Function). Without it
# the summarize endpoints answer 503 and everything else works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
