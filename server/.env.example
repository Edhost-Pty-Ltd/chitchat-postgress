# ─── ChitChatBusiness backend environment ───────────────────────────────────
# Copy to .env and fill in real values. Every variable here is required unless
# marked optional; the server exits on startup if a required one is missing.

# HTTP listen port for the REST API + Socket.IO gateway.
PORT=4000

# Node environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string.
# Matches docker-compose.yml defaults.
DATABASE_URL=postgres://chitchat:chitchat@localhost:5432/chitchat
# Postgres TLS mode: disable (local), require (RDS, chain NOT verified), or
# verify (RDS, chain verified against system CAs + DATABASE_CA_CERT).
DATABASE_SSL=disable
# PEM bundle used only when DATABASE_SSL=verify. Inline PEM contents or a path
# to a .pem file (e.g. the AWS RDS global CA bundle).
# DATABASE_CA_CERT=/etc/ssl/certs/rds-global-bundle.pem

# Redis connection string (presence, typing, pub/sub adapter, rate limits, BullMQ).
# Use rediss:// (or set REDIS_TLS=true) for ElastiCache in-transit encryption.
REDIS_URL=redis://localhost:6379
# Force TLS even when the URL scheme is redis:// (rediss:// implies TLS).
REDIS_TLS=false

# ─── Object store (S3-compatible: MinIO locally, S3 / R2 in prod) ────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chitchat-media
S3_ACCESS_KEY_ID=chitchat
S3_SECRET_ACCESS_KEY=chitchat-secret
# true for MinIO / path-style endpoints; false for AWS S3 virtual-hosted style.
S3_FORCE_PATH_STYLE=true

# ─── Firebase Admin (token verification only — Auth stays on Firebase) ───────
# Provide EITHER a path to a service-account JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...OR the raw JSON (useful for container deploys). One of the two is required.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# The Firebase project id (defaults to the service account's project_id).
FIREBASE_PROJECT_ID=chitchatbusiness-880ce

# ─── CORS / Socket.IO origins ────────────────────────────────────────────────
# Comma-separated allow-list of origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Expo push endpoint (override only for testing).
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ─── Auth token cache (performance) ──────────────────────────────────────────
# Seconds to cache a verified Firebase token's decoded identity in memory, so
# repeat HTTP requests skip the network round-trip to Firebase (and the per-
# request users upsert). A revoked/removed token stays accepted for at most this
# long on the HTTP path; socket handshakes always do a fresh checkRevoked
# verification. Set to 0 to disable caching. Default: 60.
AUTH_TOKEN_CACHE_TTL_SEC=60

# ─── AI meeting minutes (optional) ───────────────────────────────────────────
# Server-side Gemini key used to transcribe meeting recordings and write the
# minutes (replaces the summarizeMeetingRecording Cloud Function). Without it
# the summarize endpoints answer 503 and everything else works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Meetings ────────────────────────────────────────────────────────────────
# Public web app that hosts the meeting room. Meeting invite cards link to
# ${MEET_URL_BASE}/meet/<meetingId>.
#
# Set this to the URL where your Expo web build is deployed — e.g.:
#   MEET_URL_BASE=https://app.yourcompany.com    (production)
#   MEET_URL_BASE=http://localhost:8081            (local Expo web dev server)
#
# The client side auto-detects window.location.origin at runtime on web, so
# for local dev you only need to set this here on the server so that invitation
# cards sent to other participants contain the correct URL.
MEET_URL_BASE=http://localhost:8081

# Google Places API key for the in-person venue search (server-side proxy so
# the key never ships in the app). Optional: without it the /places routes fall
# back to OpenStreetMap Nominatim, which also returns real, existing places.
GOOGLE_PLACES_API_KEY=

# ─── Face registration / reported-user re-verification ──────────────────────
# Must be the SAME random secret in `face recognition_feat/.env`. Django signs
# purpose-separated proofs after FaceAISDK enrollment/liveness for new accounts
# and after a live match for reported accounts; this backend verifies them
# before creating or unlocking the account.
# Generate with: openssl rand -base64 48
# NEVER expose this value through an EXPO_PUBLIC_* variable.
FACE_VERIFICATION_RECEIPT_SECRET=replace-with-at-least-32-random-characters

# ─── Admin-assisted agent face enrollment ───────────────────────────────────
# Separate from FACE_VERIFICATION_RECEIPT_SECRET. Node mints a one-time grant
# only for an owner/admin's pending agent; Django consumes it, stores only an
# encrypted reference feature extracted on-device by the SDK, and returns a
# completion receipt. Set the SAME random value in face recognition_feat/.env.
# Never expose through EXPO_PUBLIC_*. Generate with: openssl rand -base64 48
AGENT_FACE_ENROLLMENT_SECRET=replace-with-at-least-32-random-characters
