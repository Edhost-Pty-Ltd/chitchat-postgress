{
  "name": "chitchat-server",
  "version": "1.0.0",
  "description": "ChitChatBusiness backend: REST API + Socket.IO gateway (Postgres, Redis, S3-compatible storage)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate up -m migrations -j sql --no-check-order",
    "migrate:down": "node-pg-migrate down -m migrations -j sql --no-check-order",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@fastify/cors": "^10.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.21.2",
    "fastify": "^5.1.0",
    "firebase-admin": "^12.7.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "fast-check": "^4.8.0",
    "node-pg-migrate": "^7.7.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.5"
  },
  "private": true
}
