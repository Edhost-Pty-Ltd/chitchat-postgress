# Dependencies — reinstalled inside the image from the lockfile.
node_modules
dist

# Secrets — injected at runtime via env / Secrets Manager, never baked in.
.env
.env.*
firebase-service-account.json

# Local / editor / VCS noise.
.git
.gitignore
*.log
.DS_Store
coverage
.vitest

# Tests and local-only config not needed in the runtime image.
**/*.test.ts
src/test
vitest.config.ts
README.md
Dockerfile
.dockerignore
